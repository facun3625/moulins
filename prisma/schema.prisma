// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Config de la tienda ----------

enum OrderingMode {
  WEEKLY_HOURS
  SCHEDULED_SALES
}

model StoreConfig {
  id                   Int          @id @default(1)
  orderingMode         OrderingMode @default(SCHEDULED_SALES)
  ordersManuallyClosed Boolean      @default(false)
  // Apagado general de la tienda desde el admin — independiente del modo y
  // de los horarios/fechas configurados. Mientras esté en false, el
  // storefront muestra "Tienda cerrada" y no se puede hacer ningún pedido.
  storeOpen            Boolean      @default(true)
}

// ---------- Auth ----------

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  address       String?
  passwordHash  String?
  role          Role      @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  orders           Order[]
  pointsLedger     PointsLedger[]
  couponRedemption CouponRedemption[]
  whatsappLogs     WhatsappLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Catálogo ----------

model ProductCategory {
  id       String    @id @default(cuid())
  name     String    @unique
  icon     String?
  active   Boolean   @default(true)
  products Product[]
}

model Product {
  id           String   @id @default(cuid())
  categoryId   String
  stockGroupId String
  name         String
  description  String?
  active       Boolean  @default(true)
  featured     Boolean  @default(false)
  // Pausa rápida sin fecha ni cantidad, solo tiene efecto en modo
  // WEEKLY_HOURS (delivery del día) — en SCHEDULED_SALES manda el stock
  // por fecha en su lugar.
  soldOutToday Boolean  @default(false)
  // Para productos "a pedido" (catering, encargos grandes, etc.) donde el
  // precio varía por consulta — oculta el precio y el carrito, y en su
  // lugar muestra un botón de WhatsApp. Las variantes siguen existiendo
  // para no romper el modelo, pero su precio no se le muestra al cliente.
  contactToBuy Boolean  @default(false)
  tags         String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category     ProductCategory  @relation(fields: [categoryId], references: [id])
  stockGroup   StockGroup       @relation(fields: [stockGroupId], references: [id])
  variants       ProductVariant[]
  images         ProductImage[]
  productStock   ProductStock[]
  stockMovements StockMovement[]

  @@index([stockGroupId])
}

// Todo producto pertenece a un grupo de stock: uno propio (stock
// individual) o uno compartido con otros productos (ej: "Pizzas" con 100
// unidades a repartir entre todos los gustos). El stock siempre se maneja
// a nivel grupo/producto, nunca por variante.
model StockGroup {
  id                   String @id @default(cuid())
  name                 String @unique
  defaultStockQuantity Int?

  products       Product[]
  stock          StockGroupStock[]
  stockMovements StockMovement[]
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  gusto     String?
  tamano    String?
  sku       String?
  price     Decimal  @db.Decimal(10, 2)
  active    Boolean  @default(true)
  order     Int      @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String
  order     Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ---------- Fechas de entrega y stock ----------

enum DeliveryDateStatus {
  OPEN
  CLOSED
  EXPIRED
}

// Cómo se maneja el stock para una fecha puntual: BY_GROUP usa los pozos
// compartidos (StockGroupStock, lo que ya tiene armado cada producto);
// BY_PRODUCT ignora los grupos y deja cargar un número por producto solo
// para esta fecha (ProductStock); UNLIMITED no trackea nada, todo
// disponible siempre.
enum DateStockMode {
  BY_GROUP
  BY_PRODUCT
  UNLIMITED
}

enum StockMovementReason {
  SALE // un pedido consumió stock
  RESTOCK // un pedido se canceló/borró y liberó lo que había consumido
  ADJUSTMENT // el admin cambió el tope disponible a mano
}

model DeliveryDate {
  id          String             @id @default(cuid())
  date        DateTime
  orderOpenAt DateTime?
  cutoffAt    DateTime?
  capacity    Int?
  status      DeliveryDateStatus @default(OPEN)
  stockMode   DateStockMode      @default(BY_GROUP)
  notes       String?
  createdAt   DateTime           @default(now())

  stockGroupStock StockGroupStock[]
  productStock    ProductStock[]
  orders          Order[]
  pickupSlots     PickupSlot[]
  stockMovements  StockMovement[]
  costs           DeliveryDateCost[]
}

// Costos sueltos cargados a mano para una fecha puntual (ej: ingredientes,
// delivery, alquiler del local ese día) — opcional, se van agregando de a
// uno. Sirve para sacar el resultado neto (ventas - costos) en Estadísticas.
model DeliveryDateCost {
  id             String   @id @default(cuid())
  deliveryDateId String
  label          String
  amount         Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  deliveryDate DeliveryDate @relation(fields: [deliveryDateId], references: [id], onDelete: Cascade)

  @@index([deliveryDateId])
}

// Modo "horario semanal": un día de la semana habilitado, con 1 o 2 franjas
// (WeeklyScheduleWindow) de pedido + entrega/retiro (ej: mediodía y noche).
model WeeklyScheduleRule {
  id      String  @id @default(cuid())
  weekday Int     @unique
  enabled Boolean @default(true)

  windows WeeklyScheduleWindow[]
}

model WeeklyScheduleWindow {
  id               String @id @default(cuid())
  ruleId           String
  order            Int    @default(0)
  orderOpenTime    String
  orderCloseTime   String
  fulfillmentStart String
  fulfillmentEnd   String

  rule WeeklyScheduleRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

// ---------- Entrega (delivery / retiro) ----------

enum FulfillmentType {
  DELIVERY
  PICKUP
}

model FulfillmentMethodConfig {
  id      String          @id @default(cuid())
  type    FulfillmentType @unique
  enabled Boolean         @default(false)
  config  Json?
}

model PickupSlot {
  id             String  @id @default(cuid())
  deliveryDateId String?
  label          String
  order          Int     @default(0)

  deliveryDate DeliveryDate? @relation(fields: [deliveryDateId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@index([deliveryDateId])
}

model StockGroupStock {
  id                String @id @default(cuid())
  stockGroupId      String
  deliveryDateId    String
  quantityAvailable Int? // null = sin límite
  quantitySold      Int  @default(0)

  stockGroup   StockGroup   @relation(fields: [stockGroupId], references: [id], onDelete: Cascade)
  deliveryDate DeliveryDate @relation(fields: [deliveryDateId], references: [id], onDelete: Cascade)

  @@unique([stockGroupId, deliveryDateId])
}

// Stock por producto para una fecha en modo BY_PRODUCT (ignora el grupo
// del producto: cada uno se carga por separado, solo para esa fecha).
model ProductStock {
  id                String @id @default(cuid())
  productId         String
  deliveryDateId    String
  quantityAvailable Int? // null = sin límite
  quantitySold      Int  @default(0)

  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  deliveryDate DeliveryDate @relation(fields: [deliveryDateId], references: [id], onDelete: Cascade)

  @@unique([productId, deliveryDateId])
}

// Historial de cada cambio al stock de una fecha: ventas (al confirmar un
// pedido), reposiciones (al cancelar/borrar uno) y ajustes manuales del
// admin. "delta" es el cambio en el remanente (negativo = bajó, positivo =
// subió); quantityAvailable/quantitySold son la foto resultante.
model StockMovement {
  id                String              @id @default(cuid())
  deliveryDateId    String
  stockGroupId      String?
  productId         String?
  reason            StockMovementReason
  delta             Int?
  quantityAvailable Int?
  quantitySold      Int
  note              String?
  createdAt         DateTime            @default(now())

  deliveryDate DeliveryDate @relation(fields: [deliveryDateId], references: [id], onDelete: Cascade)
  stockGroup   StockGroup?  @relation(fields: [stockGroupId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([deliveryDateId])
}

model StoreClosure {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
}

// ---------- Medios de pago ----------

enum PaymentMethodType {
  CASH_ON_DELIVERY
  TRANSFER
  MERCADOPAGO
}

model PaymentMethodConfig {
  id      String            @id @default(cuid())
  type    PaymentMethodType @unique
  enabled Boolean           @default(false)
  // Nombre a mostrar en vez del default (ej: "Efectivo" -> "Pago al retirar").
  label   String?
  // Solo aplica a CASH_ON_DELIVERY: si está seteado, ese medio de pago
  // se oculta para quien no tenga al menos esta cantidad de pedidos
  // previos (los invitados, sin cuenta, nunca lo cumplen).
  minPreviousOrders Int?
  config  Json?
}

// ---------- Pedidos ----------

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_REVIEW
  CONFIRMED
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

model Order {
  id                String      @id @default(cuid())
  // null = pedido de invitado (sin cuenta) — en ese caso guestName/guestEmail
  // tienen los datos que cargó a mano en el checkout.
  userId            String?
  guestName         String?
  guestEmail        String?
  deliveryDateId    String
  fulfillmentType   FulfillmentType
  pickupSlotId      String?
  deliveryAddress   String?
  deliveryPhone     String
  status            OrderStatus @default(PENDING_PAYMENT)
  paymentMethod     PaymentMethodType
  subtotal          Decimal     @db.Decimal(10, 2)
  deliveryFee       Decimal     @default(0) @db.Decimal(10, 2)
  discountFromCoupon Decimal    @default(0) @db.Decimal(10, 2)
  total             Decimal     @db.Decimal(10, 2)
  pointsEarned      Int         @default(0)
  couponId          String?
  mpPreferenceId    String?
  mpPaymentId       String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user         User?            @relation(fields: [userId], references: [id])
  deliveryDate DeliveryDate     @relation(fields: [deliveryDateId], references: [id])
  pickupSlot   PickupSlot?      @relation(fields: [pickupSlotId], references: [id], onDelete: SetNull)
  coupon       Coupon?          @relation(fields: [couponId], references: [id])
  items        OrderItem[]
  paymentProof PaymentProof?
  pointsLedger PointsLedger[]
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productVariantId String
  quantity         Int
  unitPrice        Decimal @db.Decimal(10, 2)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}

enum PaymentProofStatus {
  PENDING
  APPROVED
  REJECTED
}

model PaymentProof {
  id         String              @id @default(cuid())
  orderId    String              @unique
  url        String
  uploadedAt DateTime            @default(now())
  status     PaymentProofStatus  @default(PENDING)
  reviewedAt DateTime?
  reviewedBy String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ---------- Puntos y cupones ----------

model PointsRule {
  id             String    @id @default(cuid())
  pointsPerAmount Decimal  @db.Decimal(10, 4)
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
}

model PointsLedger {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  couponId  String?
  delta     Int
  reason    String
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id])
  order  Order?  @relation(fields: [orderId], references: [id])
  coupon Coupon? @relation(fields: [couponId], references: [id])
}

enum CouponDiscountType {
  PERCENT
  FIXED
}

model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique
  pointsCost    Int                @default(0)
  discountType  CouponDiscountType
  discountValue Decimal            @db.Decimal(10, 2)
  active        Boolean            @default(true)
  usageLimit    Int?
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())

  orders       Order[]
  pointsLedger PointsLedger[]
  redemptions  CouponRedemption[]
}

model CouponRedemption {
  id         String   @id @default(cuid())
  userId     String?
  couponId   String
  orderId    String?
  redeemedAt DateTime @default(now())

  user   User?  @relation(fields: [userId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])
}

// ---------- Config general ----------

model Settings {
  key   String @id
  value String
}

// Historial de cada mail que la app intentó mandar (confirmación de
// pedido, recuperación de contraseña, pruebas desde el admin) — para poder
// ver desde el panel si efectivamente salieron, sin depender del proveedor
// SMTP externo.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  type      String
  success   Boolean
  error     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Queda registrado cada vez que un admin le manda un WhatsApp a un cliente
// desde una campaña — no hay forma de confirmar que WhatsApp lo entregó (el
// envío pasa por WhatsApp Web, fuera de la app), esto solo marca que el
// admin abrió el link con el mensaje.
model WhatsappLog {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  message   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------- Sobre nosotros ----------

enum AboutMediaType {
  IMAGE
  VIDEO
}

model AboutMedia {
  id        String         @id @default(cuid())
  type      AboutMediaType
  url       String
  order     Int            @default(0)
  createdAt DateTime       @default(now())
}
