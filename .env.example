# Base de datos.
# En desarrollo local (npm run dev, DB corriendo con `docker compose up -d db`):
#   DATABASE_URL="postgresql://pedidos:pedidos@localhost:5442/pedidos"
# En el VPS (DB como contenedor suelto, puerto mapeado al host — Paso 2 y 3
# de la guía de deploy):
#   DATABASE_URL="postgresql://moulins_user:<password>@localhost:<PUERTO_DB>/moulins_db"
DATABASE_URL=""

# PM2 lo usa para levantar la app en el puerto que le corresponda en el VPS
# (Paso 0/5 de la guía). En local no hace falta, next dev usa 3000 fijo.
PORT=""

# Auth.js — cualquier string random largo. Generalo con: openssl rand -base64 32
AUTH_SECRET=""

# Login con Google (Google Cloud Console > APIs & Services > Credentials).
# Redirect URI autorizado: https://<tu-dominio>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# El SMTP del mail de confirmación de pedido NO va acá — se carga desde
# Configuración → Mail en el panel de admin (queda guardado en la base).
